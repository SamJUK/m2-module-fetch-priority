includes:
    - vendor/samjuk/dev-standards/php/magento/phpstan.neon

parameters:
    paths:
        - Api
        - Enum
        - Model
        - Observer
        - Plugin
        - Test
        - ViewModel
        - registration.php
    # ponytail: level 1 keeps parity with the old config; dev-standards default is 6.
    level: 1
